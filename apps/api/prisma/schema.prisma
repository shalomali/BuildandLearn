generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @default("")
  name         String?
  createdAt    DateTime @default(now())

  projects       Project[]
  learningEvents LearningEvent[]
  profile        LearningProfile?
}

model Project {
  id                String   @id @default(uuid())
  userId            String?
  title             String
  description       String?
  stack             String   // Stored as JSON string
  experienceLevel   String   // 'beginner' | 'intermediate' | 'advanced'
  familiarWithStack Boolean  @default(false)
  priority          String   // 'learning' | 'balanced' | 'fast'
  designMode        String   // 'beginner' | 'guided' | 'independent'
  phase             String   @default("definition") // 'definition' | 'learning_plan' | ...
  roadmap           String?  // JSON string
  architecture      String?  // JSON string
  status            String   @default("active")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user             User?            @relation(fields: [userId], references: [id])
  projectConcepts  ProjectConcept[]
  milestones       Milestone[]
  learningEvents   LearningEvent[]
  codeAttributions CodeAttribution[]
}

model Concept {
  id            String   @id @default(uuid())
  name          String   @unique
  category      String
  prerequisites String   @default("[]") // JSON string of concept names/IDs
  description   String

  projectConcepts ProjectConcept[]
  learningEvents  LearningEvent[]
  codeAttributions CodeAttribution[]
}

model ProjectConcept {
  id                 String    @id @default(uuid())
  projectId          String
  conceptId          String
  selectedByLearner  Boolean   @default(true)
  status             String    @default("not_started") // 'not_started' | 'in_progress' | 'learned' | 'mastered' | 'needs_review'
  confidenceScore    Float     @default(0.0)
  firstEncounteredAt DateTime?
  learnedAt          DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@unique([projectId, conceptId])
}

model LearningProfile {
  userId               String   @id
  conceptHistory       String   // JSON string
  learningPreferences  String   // JSON string
  independenceTrend    String   // JSON string
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Milestone {
  id          String    @id @default(uuid())
  projectId   String
  title       String
  description String?
  orderIndex  Int
  status      String    @default("pending") // 'pending' | 'active' | 'completed'
  completedAt DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model LearningEvent {
  id           String   @id @default(uuid())
  projectId    String
  userId       String?
  conceptId    String?
  eventType    String
  payload      String   // JSON string
  providerUsed String?
  createdAt    DateTime @default(now())

  project Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id])
  concept Concept? @relation(fields: [conceptId], references: [id])
}

model CodeAttribution {
  id        String   @id @default(uuid())
  projectId String
  filePath  String
  lineStart Int
  lineEnd   Int
  author    String   // 'ai' | 'learner'
  conceptId String?
  createdAt DateTime @default(now())

  project Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  concept Concept? @relation(fields: [conceptId], references: [id])
}

model AIProviderCall {
  id           String   @id @default(uuid())
  role         String
  provider     String
  model        String
  success      Boolean
  latencyMs    Int
  fallbackFrom String?
  createdAt    DateTime @default(now())
}
