# ====================================================
# Build&Learn API Server Environment Configuration
# ====================================================

# Port for REST API and WebSocket server (default: 4000)
PORT=4000

# Secret key for JWT authentication signing (use any random string)
JWT_SECRET=your_jwt_secret_key_here

# AI Provider API Keys
# If omitted or blank, the server automatically falls back to MockAdapter (smart mock responses) so the app runs $0 free for local dev.

# Google Gemini API Key - Get free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq API Key - Get free key at: https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter API Key - Get free key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# DeepSeek API Key - Get key at: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Anthropic Claude API Key (optional, only needed if upgrading specific roles — leave blank by default)
ANTHROPIC_API_KEY=
